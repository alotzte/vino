# Путь монтирования за HAProxy (app.nektarum.ru/vino/). Для локального запуска - пусто.
VINO_ROOT_PATH=/vino

# Движок распознавания: remote (отдельный CV-контейнер) или stub (заглушка без GPU)
VINO_ENGINE=remote

# Ниже этого косинуса UI показывает "не найдено"; в flat=1 порог не применяется
VINO_CONFIDENCE_THRESHOLD=0.680

# Таймаут похода в CV, секунды. Скрипт оценки рвёт соединение на 10 с
VINO_CV_TIMEOUT=8

# Параметры каскада распознавания
VINO_CV_TOP_K=20
VINO_CV_GEO_W=0.5
VINO_CV_GEO_CAP=200
# Ч/б-гейт: 0 - выключен (на витрине режет 9% кадров)
VINO_CV_SAT_GATE=0
# Проба поворотов при низком косинусе: 1 - включить
VINO_CV_ROTATION_PROBE=0

# Ключ LLM для "Цифрового сомелье" (пока не используется)
VINO_LLM_API_KEY=
